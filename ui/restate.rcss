/* Black around the centered 640 by 400 picture. */
body
{
	background-color: #000000;
}

#frame
{
	position: absolute;
	width: 640dp;
	height: 400dp;
	decorator: image(score.pcx);
}

/*
 * The room a wider or taller screen leaves beside the picture shows the picture again,
 * mirrored at its edge and darkened to a half, falling to a quarter over the first 36dp.
 */
.mirror
{
	position: absolute;
	width: 640dp;
	height: 400dp;
}

.mirror .shade, .mirror .falloff
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

#mirror-left
{
	left: -640dp;
	top: 0;
	decorator: image(score.pcx flip-horizontal);
}

#mirror-left .falloff
{
	left: 604dp;
	width: 36dp;
	decorator: horizontal-gradient(#000000c0 #00000080);
}

#mirror-left .shade
{
	width: 604dp;
	background-color: #000000c0;
}

#mirror-right
{
	left: 640dp;
	top: 0;
	decorator: image(score.pcx flip-horizontal);
}

#mirror-right .falloff
{
	width: 36dp;
	decorator: horizontal-gradient(#00000080 #000000c0);
}

#mirror-right .shade
{
	left: 36dp;
	width: 604dp;
	background-color: #000000c0;
}

#mirror-top
{
	left: 0;
	top: -400dp;
	decorator: image(score.pcx flip-vertical);
}

#mirror-top .falloff
{
	top: 364dp;
	height: 36dp;
	decorator: vertical-gradient(#000000c0 #00000080);
}

#mirror-top .shade
{
	height: 364dp;
	background-color: #000000c0;
}

#mirror-bottom
{
	left: 0;
	top: 400dp;
	decorator: image(score.pcx flip-vertical);
}

#mirror-bottom .falloff
{
	height: 36dp;
	decorator: vertical-gradient(#00000080 #000000c0);
}

#mirror-bottom .shade
{
	top: 36dp;
	height: 364dp;
	background-color: #000000c0;
}

/* The picture's wide stand-in, which the screen sizes and fills in when there is one. */
#wide
{
	position: absolute;
	top: 0;
	height: 400dp;
}

#box
{
	position: absolute;
	left: 110dp;
	top: 60dp;
	width: 420dp;
	height: 280dp;
	text-align: center;
}

/* Centered by its widest line, set flush left, and sized to break lines as the old font did. */
#page
{
	display: inline-block;
	text-align: left;
	font-family: fullfnt;
	font-size: 13dp;
	letter-spacing: 1dp;
}

.line
{
	height: 20dp;
	line-height: 20dp;
	white-space: pre;
	visibility: hidden;
}

/* White blob, pale blob, then text, in GDI's colors; side style sheets replace them. */
.line.blob, .line.fade, .line.ink
{
	visibility: visible;
}

.line.blob
{
	color: #fcfcfc;
	font-effect: glow(4dp 1dp 0dp 0dp #fcfcfc);
}

.line.fade
{
	color: #78d4b8;
	font-effect: outline(3dp #78d4b8);
}

.line.ink
{
	color: #20d460;
}

#frame button
{
	position: absolute;
	width: 150dp;
}

#more
{
	left: 245dp;
	top: 340dp;
}

#resume
{
	left: 245dp;
	top: 360dp;
}

#resume.paired
{
	left: 85dp;
	top: 348dp;
}

#video
{
	left: 405dp;
	top: 348dp;
}

/* A click here finishes a fading page. */
#skip
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
